&CONTROL
   calculation      = 'vc-relax'
   verbosity        = 'low'
   restart_mode     = 'from_scratch'
   nstep            = 5000
   tstress          = .true.
   tprnfor          = .true.
   outdir           = './tmp'
   prefix           = 'pwscf'
   max_seconds      = 82800
   etot_conv_thr    = 0.0001
   forc_conv_thr    = 0.001
   pseudo_dir       = '/leonardo_scratch/large/userexternal/nalghamd/mc_mace/PP-r2scan'
/
&SYSTEM
   ecutwfc          = 80
   ecutrho          = 320
   occupations      = 'smearing'
   degauss          = 0.01
   smearing         = 'cold'
   input_dft        = 'XC-000I-000I-000I-000I-497L-498L'
   ntyp             = 1
   nat              = 2
   ibrav            = 0
/
&ELECTRONS
   electron_maxstep = 1000
   conv_thr         = 1e-08
   mixing_mode      = 'plain'
   mixing_beta      = 0.7
   diagonalization  = 'david'
   startingwfc      = 'atomic'
/
&IONS
/
&CELL
/
&FCP
/
&RISM
/
ATOMIC_SPECIES
Na 22.98976928 Na_ONCV_PBE-1.2.upf

K_POINTS automatic
3 5 1  0 0 0

CELL_PARAMETERS angstrom
4.20805360000000 0.00000000000000 0.00000000000000
0.00000000000000 4.20805360000000 0.00000000000000
0.00000000000000 0.00000000000000 4.20805360000000

ATOMIC_POSITIONS angstrom
Na 0.0000000000 0.0000000000 0.0000000000  
