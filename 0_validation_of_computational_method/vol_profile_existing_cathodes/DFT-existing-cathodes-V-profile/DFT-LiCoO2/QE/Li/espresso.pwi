&CONTROL
   calculation      = 'vc-relax'
   verbosity        = 'low'
   restart_mode     = 'from_scratch'
   tstress          = .true.
   tprnfor          = .true.
   outdir           = './tmp'
   prefix           = 'pwscf'
   max_seconds      = 82800
   etot_conv_thr    = 0.0001
   forc_conv_thr    = 0.001
   pseudo_dir       = '/leonardo_scratch/large/userexternal/nalghamd/mc_mace/PP-r2scan'
/
&SYSTEM
   ecutwfc          = 40
   ecutrho          = 320
   occupations      = 'smearing'
   degauss          = 0.01
   smearing         = 'cold'
   input_dft        = 'XC-000I-000I-000I-000I-497L-498L'
   ntyp             = 1
   nat              = 2
   ibrav            = 0
/
&ELECTRONS
   electron_maxstep = 5000
   conv_thr         = 1e-08
   mixing_mode      = 'plain'
   mixing_beta      = 0.7
   diagonalization  = 'david'
   startingwfc      = 'atomic'
/
&IONS
/
&CELL
/
&FCP
/
&RISM
/
ATOMIC_SPECIES
Li 6.94 Li_ONCV_PBE-1.2.upf

K_POINTS automatic
10 10 2  0 0 0

