&CONTROL
   calculation      = 'vc-relax'
   verbosity        = 'low'
   restart_mode     = 'from_scratch'
   nstep            = 5000
   tstress          = .true.
   tprnfor          = .true.
   outdir           = './tmp'
   prefix           = 'pwscf'
   max_seconds      = 82800
   etot_conv_thr    = 0.0001
   forc_conv_thr    = 0.001
   pseudo_dir       = '/leonardo_scratch/large/userexternal/nalghamd/mc_mace/PP-r2scan'
/
&SYSTEM
   ecutwfc          = 70
   ecutrho          = 280
   occupations      = 'smearing'
   degauss          = 0.01
   smearing         = 'cold'
   input_dft        = 'XC-000I-000I-000I-000I-497L-498L'
