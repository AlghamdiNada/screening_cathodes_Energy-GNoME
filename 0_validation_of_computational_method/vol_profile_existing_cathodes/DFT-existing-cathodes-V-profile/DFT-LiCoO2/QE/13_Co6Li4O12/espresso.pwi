   nat              = 22
   ibrav            = 0
/
&ELECTRONS
   electron_maxstep = 1000
   conv_thr         = 1e-08
   mixing_mode      = 'plain'
   mixing_beta      = 0.7
   diagonalization  = 'david'
   startingwfc      = 'atomic'
/
&IONS
/
&CELL
/
&FCP
/
&RISM
